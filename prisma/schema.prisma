datasource db {
  provider = "postgresql"
  url      = env("APP_DB_CONNECTION_STRING")
}

generator client {
    provider = "prisma-client-js"
}

generator typegraphql {
    provider        = "typegraphql-prisma"
    output          = "./generated/type-graphql"
    simpleResolvers = true
}

model User {
    id Int @default(autoincrement()) @map("id")
    email String @unique
    userName String @map("user_name") @db.Char(100)
    password String @db.Char(50)

    @@id([id])
    @@map("users")
}
