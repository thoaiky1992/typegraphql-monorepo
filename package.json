{
  "name": "typegraphql-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TypeGraphQL Federation Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:user\" \"npm run dev:product\" \"npm run dev:gateway\"",
    "dev:user": "npm run dev -w @repo/service-user",
    "dev:product": "npm run dev -w @repo/service-product",
    "dev:gateway": "npm run dev -w @repo/service-gateway",
    "build": "npm run prisma:generate && npm run build:shared && npm run build:services",
    "build:shared": "npm run build -w @repo/shared",
    "build:services": "npm run build -w @repo/service-user && npm run build -w @repo/service-product && npm run build -w @repo/service-gateway",
    "start": "concurrently --kill-others \"npm run start -w @repo/service-user\" \"npm run start -w @repo/service-product\" \"npm run start -w @repo/service-gateway\"",
    "lint": "eslint ./packages",
    "lint:fix": "eslint ./packages --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prisma:generate": "npm run generate -w @repo/prisma",
    "prisma:migrate": "npm run migrate -w @repo/prisma",
    "prisma:db:push": "npm run db:push -w @repo/prisma",
    "prisma:seed": "npm run seed -w @repo/prisma",
    "prisma:studio": "npm run studio -w @repo/prisma",
    "introspect:user": "bash introspect-service-user.sh",
    "introspect:product": "bash introspect-service-product.sh",
    "introspect:compose": "bash introspect-service-compose.sh",
    "codegen": "graphql-codegen -c codegen.ts",
    "clean": "rimraf ./packages/*/dist ./packages/*/node_modules ./node_modules",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@apollo/rover": "^0.23.0",
    "@graphql-codegen/add": "^5.0.2",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.2.1",
    "@graphql-codegen/typescript-resolvers": "^4.1.0",
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/graphql-upload": "^15.0.2",
    "@types/ioredis": "^5.0.0",
    "@types/lodash": "^4.17.0",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "concurrently": "^8.2.2",
    "env-cmd": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "prisma": "^5.13.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typegraphql-prisma": "^0.27.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@apollo/gateway": "2.4.13",
    "@apollo/server": "4.9.5",
    "@apollo/subgraph": "2.5.7",
    "@prisma/client": "^5.13.0",
    "@profusion/apollo-federation-upload": "^4.2.0",
    "@types/graphql-fields": "^1.3.9",
    "amqplib": "^0.10.4",
    "body-parser": "^1.20.2",
    "bullmq": "^5.7.14",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "flowed": "^1.14.7",
    "graphql": "^16.8.1",
    "graphql-fields": "^2.0.3",
    "graphql-request": "^6.1.0",
    "graphql-scalars": "^1.23.0",
    "graphql-tag": "^2.12.6",
    "graphql-tools": "^9.0.1",
    "graphql-upload": "15.0.2",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mustache": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.6.2",
    "tsyringe": "^4.8.0",
    "type-graphql": "2.0.0-beta.3",
    "typedi": "^0.10.0",
    "winston": "^3.13.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
