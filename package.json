  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint ./@shared ./services",
    "lint:fix": "eslint ./@shared ./services --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "start:service:user": "nodemon --exec ts-node ./services/user/server.ts",
    "start:service:product": "nodemon --exec ts-node ./services/product/server.ts",
    "start:service:all": "concurrently --kill-others \"npm run start:service:user\" \"npm run start:service:product\"",
    "start:service:gateway": "nodemon --exec ts-node ./services/gateway/server.ts",
    "introspect:service:user": "bash introspect-service-user.sh",
    "introspect:service:product": "bash introspect-service-product.sh",
    "introspect:service:compose": "bash introspect-service-compose.sh",
    "codegen": "graphql-codegen -c codegen.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
