{
  "name": "@repo/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "require": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    },
    "./helpers": {
      "import": "./dist/helpers/index.js",
      "require": "./dist/helpers/index.js",
      "types": "./dist/helpers/index.d.ts"
    },
    "./helpers/*": {
      "import": "./dist/helpers/*.js",
      "require": "./dist/helpers/*.js",
      "types": "./dist/helpers/*.d.ts"
    },
    "./interface": {
      "import": "./dist/interface/index.js",
      "require": "./dist/interface/index.js",
      "types": "./dist/interface/index.d.ts"
    },
    "./library": {
      "import": "./dist/library/index.js",
      "require": "./dist/library/index.js",
      "types": "./dist/library/index.d.ts"
    },
    "./library/saga": {
      "import": "./dist/library/saga/index.js",
      "require": "./dist/library/saga/index.js",
      "types": "./dist/library/saga/index.d.ts"
    },
    "./library/saga/*": {
      "import": "./dist/library/saga/*.js",
      "require": "./dist/library/saga/*.js",
      "types": "./dist/library/saga/*.d.ts"
    },
    "./library/*": {
      "import": "./dist/library/*.js",
      "require": "./dist/library/*.js",
      "types": "./dist/library/*.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "require": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    }
  }
}
